# GraphQL schema example
#
# https://gqlgen.com/getting-started/

# gqlgen supports some custom scalars out of the box
# see: https://github.com/99designs/gqlgen/blob/master/docs/content/reference/scalars.md

# resolves to time.Time
scalar Time

# resolves to map[string]interface{}
scalar Map

# resolves to interface{}
scalar Any

# needed if all models are autobinded and none is generated
type Dummy {
  id:        ID!
}

# resolves to the following struct
# type Upload struct {
# 	File     io.Reader
# 	Filename string
# 	Size     int64
# }
scalar Upload

type Player {
  id:        ID!
  name:      String!
  steamid:   String!
  profileid: String!
  stats:     PlayerStats!
}

type PlayerStats {
  matches:          Int!
  kills:            Int!
  deaths:           Int!
  assists:          Int!
  headshots:        Int!
  headshotRate:     Float!
  killDeathRatio:   Float!
  killsPerMatch:    Float!
}

type MatchParticipant {
  player: Player!
  stats:  PlayerStats!
}

type Match {
	id:              ID!
	server:          String
	gamemode:        String!
	mapgroup:        String!
	mapfullname:     String!
	mapname:         String!
	scorea:          Int!
	scoreb:          Int!
	rounds:          Int!
	start:           Time!
	end:             Time!
	durationSeconds: Int!
	completed:       Boolean!
	participants:    [MatchParticipant!]!
}

type Query {
  players(name: String, limit: Int! = 50, offset: Int! = 0): [Player!]!
  player(id: ID!): Player
  matches(limit: Int! = 50, offset: Int! = 0): [Match!]!
  match(id: ID!): Match
}
